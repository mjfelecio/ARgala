  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reactvision/react-viro": "3.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "heroui-native": "1.0.10",
    "i18next": "^26.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.20",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4",
    "unicode-segmenter": "0.17.3",
    "uniwind": "1.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "postinstall": "node scripts/apply-native-patches.mjs",
    "check:native-patches": "node scripts/apply-native-patches.mjs --check",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:android": "expo export --platform android",
    "check:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/places-nearby/index.ts supabase/functions/place-details/index.ts supabase/functions/walking-route/index.ts supabase/functions/route-preview/index.ts supabase/functions/places-search/index.ts",
    "test:limiter": "python3 scripts/test-rate-limiter.py",
    "check:android": "node scripts/check-android-config.mjs",
    "lint:edge": "npx --yes deno@2.9.6 lint --config supabase/functions/deno.json supabase/functions",
    "test:journal-sync": "python3 scripts/test-journal-sync.py"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

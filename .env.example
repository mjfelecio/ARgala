# Public client configuration. Never put service-role or Google web-service keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Embedded in the Android binary. Restrict to Maps SDK for Android + package/SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# Set after linking this project to EAS. Not a credential.
EAS_PROJECT_ID=
